CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_tplink_ec220-g5-v2=y

# =========================================================
# 1. ОБЯЗАТЕЛЬНАЯ БАЗА И ВЕБ-ИНТЕРФЕЙС (Строго со скриншота)
# =========================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# =========================================================
# 2. НАШ НЕОБХОДИМЫЙ ФУНКЦИОНАЛ (SQM, UPnP, Full Cone NAT)
# =========================================================
# SQM / Cake (для борьбы с буферблотом)
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-sched-cake=y

# UPnP (автоматический проброс портов)
CONFIG_PACKAGE_luci-app-upnp=y

# Full Cone NAT через TurboACC (для Open NAT в играх)
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOAD=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_FULLCONENAT=y
CONFIG_PACKAGE_kmod-ipt-fullconenat=y

# =========================================================
# 3. ТОТАЛЬНОЕ ОТКЛЮЧЕНИЕ ВСЕХ СТОРОННИХ ПАКЕТОВ LEAN
# =========================================================

# Язык Python и тяжелые библиотеки (экономия ~4 МБ)
CONFIG_PACKAGE_python3=n
CONFIG_PACKAGE_python3-base=n
CONFIG_PACKAGE_glib2=n
CONFIG_PACKAGE_sqlite3=n
CONFIG_PACKAGE_libffi=n
CONFIG_PACKAGE_libev=n
CONFIG_PACKAGE_libsodium=n

# Прокси, VPN и обход блокировок (helloworld / passwall)
CONFIG_PACKAGE_luci-app-ssr-plus=n
CONFIG_PACKAGE_shadowsocksr-libev=n
CONFIG_PACKAGE_ipt2socks=n
CONFIG_PACKAGE_microsocks=n
CONFIG_PACKAGE_dns2tcp=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-zerotier=n

# Тяжелые сетевые утилиты и сканеры
CONFIG_PACKAGE_nmap=n
CONFIG_PACKAGE_bind-server=n
CONFIG_PACKAGE_bind-libs=n
CONFIG_PACKAGE_coreutils=n
CONFIG_PACKAGE_coremark=n
CONFIG_PACKAGE_bluez=n
CONFIG_PACKAGE_jq=n
CONFIG_PACKAGE_attr=n
CONFIG_PACKAGE_acl=n

# Встроенные сервисы и веб-приложения Lean
CONFIG_PACKAGE_vsftpd=n
CONFIG_PACKAGE_luci-app-vsftpd=n
CONFIG_PACKAGE_vlmcsd=n
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_luci-app-autoreboot=n
CONFIG_PACKAGE_luci-app-arpbind=n
CONFIG_PACKAGE_luci-app-nlbwmon=n
CONFIG_PACKAGE_nlbwmon=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_ddns-scripts_aliyun=n
CONFIG_PACKAGE_ddns-scripts_dnspod=n
CONFIG_PACKAGE_luci-app-access-control=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_etherwake=n
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_luci-app-ramfree=n
CONFIG_PACKAGE_luci-app-unblockmusic=n
CONFIG_PACKAGE_luci-theme-argon=n
