CONFIG_PACKAGE_netdata=n
CONFIG_PACKAGE_luci-app-netdata=n
CONFIG_PACKAGE_mwan3=n
CONFIG_PACKAGE_luci-app-mwan3=n
CONFIG_PACKAGE_luci-app-syncdial=n
CONFIG_PACKAGE_luci-app-eqos=n
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-usb-printer=n
CONFIG_PACKAGE_luci-app-watchcat=n
CONFIG_PACKAGE_luci-app-ipsec-vpnd=n

# === ВЫРЕЗАНИЕ НЕИСПОЛЬЗУЕМЫХ СЕТЕВЫХ ТОННЕЛЕЙ И VPN ===
CONFIG_PACKAGE_kmod-wireguard=n
CONFIG_PACKAGE_kmod-tun=n
CONFIG_PACKAGE_kmod-pptp=n
CONFIG_PACKAGE_kmod-ipsec=n
CONFIG_PACKAGE_kmod-gre=n
CONFIG_PACKAGE_kmod-l2tp=n
CONFIG_PACKAGE_luci-proto-wireguard=n
CONFIG_PACKAGE_luci-proto-openvpn=n
CONFIG_PACKAGE_luci-proto-3g=n

# === УТИЛИТЫ ОТЛАДКИ И КОНСОЛЬНЫЙ СОФТ ===
CONFIG_PACKAGE_tcpdump=n
CONFIG_PACKAGE_nano=n
CONFIG_PACKAGE_vim=n
CONFIG_PACKAGE_screen=n
CONFIG_PACKAGE_lsof=n
CONFIG_PACKAGE_strace=n
CONFIG_PACKAGE_pciutils=n
CONFIG_PACKAGE_usbutils=n
CONFIG_PACKAGE_ethtool=n
CONFIG_PACKAGE_ebtables=n
# === ОЧИСТКА ДРАЙВЕРОВ И ТЯЖЕЛЫХ МОДУЛЕЙ ЯДРА ===
CONFIG_PACKAGE_kmod-crypto-hw-padlock=n
CONFIG_PACKAGE_kmod-crypto-manager=n
CONFIG_PACKAGE_kmod-crypto-user=n
CONFIG_PACKAGE_kmod-cryptodev=n
CONFIG_PACKAGE_kmod-lib-zstd=n
CONFIG_PACKAGE_kmod-lib-xz=n
CONFIG_PACKAGE_kmod-bonding=n
CONFIG_PACKAGE_kmod-dummy=n
CONFIG_PACKAGE_kmod-ifb=n

# === ВЫРЕЗАНИЕ НЕИСПОЛЬЗУЕМЫХ СЕТЕВЫХ СЛУЖБ ===
CONFIG_PACKAGE_luci-app-qos=n
CONFIG_PACKAGE_qos-scripts=n
CONFIG_PACKAGE_luci-app-nft-qos=n
