CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_tplink_ec220-g5-v2=y

# =========================================================
# 1. ВЕБ-ИНТЕРФЕЙС И БАЗА (Защищено)
# =========================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# =========================================================
# 2. НЕОБХОДИМЫЙ ФУНКЦИОНАЛ (SQM, UPnP, Full Cone NAT)
# =========================================================
# SQM (Cake)
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-sched-cake=y

# UPnP
CONFIG_PACKAGE_luci-app-upnp=y

# Full Cone NAT (Только FullCone, без BBR и Offload)
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_FULLCONENAT=y
CONFIG_PACKAGE_kmod-ipt-fullconenat=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOAD=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR-CCA=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_PDNSD=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_DNSPROXY=n

# =========================================================
# 3. ОТКЛЮЧЕНИЕ USB И ФАЙЛОВЫХ СИСТЕМ (У роутера нет USB-порта)
# Минус ~1.5 МБ из образа
# =========================================================
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb2=n
CONFIG_PACKAGE_kmod-usb-ohci=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-storage-extras=n
CONFIG_PACKAGE_kmod-usb-storage-uas=n
CONFIG_PACKAGE_kmod-scsi-core=n
CONFIG_PACKAGE_kmod-fs-ext4=n
CONFIG_PACKAGE_kmod-fs-vfat=n
CONFIG_PACKAGE_kmod-fs-ntfs=n
CONFIG_PACKAGE_kmod-fs-ntfs3=n
CONFIG_PACKAGE_kmod-fs-exfat=n

# =========================================================
# 4. ОТКЛЮЧЕНИЕ ТЯЖЕЛЫХ БИБЛИОТЕК И CLI-УТИЛИТ LEAN
# =========================================================
CONFIG_PACKAGE_curl=n
CONFIG_PACKAGE_libcurl=n
CONFIG_PACKAGE_wget-ssl=n
CONFIG_PACKAGE_ca-certificates=n
CONFIG_PACKAGE_ca-bundle=n
CONFIG_PACKAGE_autocore=n
CONFIG_PACKAGE_htop=n
CONFIG_PACKAGE_bash=n
CONFIG_PACKAGE_iperf3=n

# Прокси, Python, системные утилиты
CONFIG_PACKAGE_python3=n
CONFIG_PACKAGE_python3-base=n
CONFIG_PACKAGE_glib2=n
CONFIG_PACKAGE_sqlite3=n
CONFIG_PACKAGE_libffi=n
CONFIG_PACKAGE_libev=n
CONFIG_PACKAGE_libsodium=n
CONFIG_PACKAGE_luci-app-ssr-plus=n
CONFIG_PACKAGE_shadowsocksr-libev=n
CONFIG_PACKAGE_ipt2socks=n
CONFIG_PACKAGE_microsocks=n
CONFIG_PACKAGE_dns2tcp=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-zerotier=n
CONFIG_PACKAGE_nmap=n
CONFIG_PACKAGE_bind-server=n
CONFIG_PACKAGE_bind-libs=n
CONFIG_PACKAGE_coreutils=n
CONFIG_PACKAGE_coremark=n
CONFIG_PACKAGE_bluez=n
CONFIG_PACKAGE_jq=n
CONFIG_PACKAGE_attr=n
CONFIG_PACKAGE_acl=n
CONFIG_PACKAGE_vsftpd=n
CONFIG_PACKAGE_luci-app-vsftpd=n
CONFIG_PACKAGE_vlmcsd=n
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_luci-app-autoreboot=n
CONFIG_PACKAGE_luci-app-arpbind=n
CONFIG_PACKAGE_luci-app-nlbwmon=n
CONFIG_PACKAGE_nlbwmon=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_ddns-scripts_aliyun=n
CONFIG_PACKAGE_ddns-scripts_dnspod=n
CONFIG_PACKAGE_luci-app-access-control=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_etherwake=n
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_luci-app-ramfree=n
CONFIG_PACKAGE_luci-app-unblockmusic=n
CONFIG_PACKAGE_luci-theme-argon=n
# === ДОПОЛНИТЕЛЬНАЯ ОЧИСТКА ВЕБ-СЕРВИСОВ И ТЯЖЕЛЫХ ПЛАГИНОВ ===
CONFIG_PACKAGE_ttyd=n
CONFIG_PACKAGE_luci-app-ttyd=n
CONFIG_PACKAGE_smartdns=n
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_adguardhome=n
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_adbyby=n
